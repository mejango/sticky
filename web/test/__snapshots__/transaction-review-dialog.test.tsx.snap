exports[`transaction review dialog > renders the MultiSend fixture 1`] = `
"<dialog aria-labelledby="transaction-review-title-1" aria-describedby="transaction-review-description-1" class="modal-dialog focus:outline-none items-start justify-center px-3 py-4 sm:px-6 sm:py-8" tabindex="-1" open=""><div class="flex max-h-[calc(100vh-2rem)] w-full max-w-3xl flex-col overflow-hidden rounded-2xl border border-smoke-300 bg-bone shadow-2xl sm:max-h-[calc(100vh-4rem)]"><header class="flex shrink-0 items-start justify-between gap-4 border-b border-smoke-200 bg-white px-4 py-4 sm:px-6"><div><p class="text-xs font-medium uppercase tracking-wide text-bluebs-600">Client safety check</p><h2 id="transaction-review-title-1" class="mt-1 font-agrandir text-xl font-medium text-ink">Review transaction</h2></div><button type="button" aria-label="Cancel transaction review" class="icon-button shrink-0 -mr-2 -mt-2"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 6 12 12M18 6 6 18" stroke-linecap="round"></path></svg></button></header><div class="min-h-0 flex-1 overflow-y-auto px-4 py-5 sm:px-6"><div class="rounded-xl border border-bluebs-100 bg-bluebs-25 px-4 py-3"><p id="transaction-review-description-1" class="whitespace-pre-line text-sm leading-relaxed text-bluebs-800">This is the exact destination, native value, and calldata the app will ask your wallet to send. Your wallet shows the gas limit and network fees before you send.</p></div><div class="mt-5 flex justify-end"><button type="button" class="btn-link min-h-[36px] text-xs">[copy tx audit prompt]</button></div><div class="mt-4 space-y-4"><section class="rounded-xl border border-smoke-200 bg-white p-4 sm:p-5"><div class="flex flex-wrap items-center gap-2"><span class="chip flex items-center gap-1.5 bg-bluebs-50 text-bluebs-700"><img alt="" aria-hidden="true" width="16" height="16" class="inline-block rounded-full " src="asset">Ethereum</span><span class="font-mono text-[11px] text-smoke-500">chain 1</span></div><dl class="mt-4 space-