            "Turn off auto-stick",
            "Take back the auto-stick adapter's trust",
            "Take back the auto-stick adapter's allowance",
            "Unstick Sticky tokens"
          ]
        }
      ]
    }
  },
  "authorityCalls": {},
  "reviewedDirectWrites": {
