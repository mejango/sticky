      "calls": 1,
      "actions": [
        "Submit a reviewed direct write"
      ]
    },
    "src/lib/contract-write.ts": {
      "calls": 1,
      "actions": [
        "Submit a reviewed direct write"
      ]
    }
  },
  "rawWalletCalls": {
