# Names only. NEXT_PUBLIC values are embedded in the browser bundle and are
# public; set them in .env.local for a local run and in Railway for a deployment.
# Never put a key or secret in this file.

# The site's own origin. Locally: http://127.0.0.1:8788
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BENDYSTRAW_URL=
NEXT_PUBLIC_TESTNET_BENDYSTRAW_URL=
# The build's git SHA, shown by /api/healthz. Railway supplies RAILWAY_GIT_COMMIT_SHA.
NEXT_PUBLIC_VERSION=

# Optional: a JB Center endpoint other than the one derived from the site origin.
NEXT_PUBLIC_JBCENTER_URL=

# Optional: Signa sign-in.
NEXT_PUBLIC_CENTER_WALLET_ENABLED=
NEXT_PUBLIC_CENTER_WALLET_ISSUER=
NEXT_PUBLIC_CENTER_WALLET_AUDIENCE=
NEXT_PUBLIC_CENTER_WALLET_MANIFEST_ID=
NEXT_PUBLIC_CENTER_WALLET_MANIFEST_REVISION=
NEXT_PUBLIC_CENTER_WALLET_MAXIMUM_NETWORK_FEE_WEI=

# Optional: leave empty to hide the WalletConnect option.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
