{
  "name": "sticky-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.0.1",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 8788",
    "build": "next build --webpack",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint . --max-warnings=0 --no-cache",
    "ts:check": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:browser": "playwright test",
    "bendystraw:registry": "node scripts/check-bendystraw-schema.mjs 0 --write-registry",
    "schema:check:offline": "node scripts/check-bendystraw-schema.mjs 0 --offline",
    "transaction:check": "node scripts/check-transaction-inventory.mjs",
    "deployments:sync": "node scripts/sync-deployments.mjs",
    "deployments:check": "node scripts/sync-deployments.mjs --check",
    "check": "npm run lint && npm run ts:check && npm run deployments:check && npm run schema:check:offline && npm run transaction:check && npm run test:ci && npm run build"
  },
  "dependencies": {
    "@bananapus/nana-sdk-connect": "^0.5.6",
    "@bananapus/nana-sdk-core": "2.12.2",
    "@coinbase/wallet-sdk": "4.3.7",
    "@safe-global/safe-apps-provider": "0.18.6",
    "@safe-global/safe-apps-sdk": "9.1.0",
    "@tanstack/react-query": "5.101.4",
    "@wagmi/core": "3.6.4",
    "@walletconnect/ethereum-provider": "2.23.10",
    "next": "16.3.3",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.55.19",
    "wagmi": "3.7.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/compat": "2.1.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.4",
    "@types/react-test-renderer": "19.1.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "10.7.0",
    "eslint-config-next": "16.3.3",
    "graphql": "17.0.2",
    "jsdom": "29.1.1",
    "knip": "6.29.0",
    "postcss": "8.5.26",
    "react-test-renderer": "19.2.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@walletconnect/jsonrpc-ws-connection": {
      "ws": "7.5.13"
    },
    "axios": "1.18.1",
    "bn.js@4": "4.12.5",
    "nanoid": "3.3.18",
    "postcss": "$postcss",
    "sharp": "0.35.4",
    "ws": "8.21.1"
  },
  "engines": {
    "node": "26.7.x",
    "npm": "12.0.x"
  },
  "allowScripts": {
    "@reown/appkit": false,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "fsevents": false,
    "unrs-resolver@1.12.2": true
  }
}
